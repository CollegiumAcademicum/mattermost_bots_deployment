# ── postbot ────────────────────────────────────────────────────────────────

# Required
URL=chat.collegiumacademicum.de
TOKEN=[ChangeME]
TEAM_NAME=Collegium
WEBUI_API_SECRET=[ChangeME] #same as POSTBOT_API_SECRET

# Optional — shown with their defaults
SESSION_TTL_SECONDS=500
SESSION_CLEANUP_INTERVAL_SECONDS=60
CHANNEL_CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=DEBUG
LOG_FILE=/app/data/logs/bot.log

# Postbot-specific
BOT_LOG_CHANNEL_ID=d7up7w3rd7bmmcfrkrj4ujk5ec
CHANNELS_TOML_PATH=/app/data/channels.toml
DB_PATH=/app/data/broadcast_log.db
TASKS_DIR=/app/data/tasks
SCHEDULER_TOML_PATH=/app/data/scheduler.toml



# ── webui ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=any-random-string-for-local
ALLOWED_HOSTS=[ChangeMe],127.0.0.1
POSTBOT_API_SECRET=[ChangeME]   #same as WEBUI_API_SECRET
POSTBOT_API_URL=http://postbot:8000

# HTTPS / security (all default to off — enable when behind TLS termination)
#HTTPS_ENABLED=true
#SECURE_SSL_REDIRECT=true
#CSRF_TRUSTED_ORIGINS=https://[ChangeMe]
#SECURE_HSTS_SECONDS=31536000

# Gunicorn tuning — optional, shown with their defaults
#GUNICORN_WORKERS=2
#GUNICORN_TIMEOUT=30
#GUNICORN_LOG_LEVEL=info



# Keycloak login (client secret from Clients -> postbot -> Credentials)
OIDC_RP_CLIENT_SECRET=[ChangeMe]
#KEYCLOAK_REALM_URL=https://id.ca-hd.de/realms/collegium
#OIDC_RP_CLIENT_ID=postbot
LDAP_ADMIN_GROUP_DN=cn=ag.it,cn=groups,cn=accounts,dc=intranet,dc=ca-hd,dc=de


